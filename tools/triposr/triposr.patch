--- a/tsr/models/isosurface.py
+++ b/tsr/models/isosurface.py
@@ -3,7 +3,19 @@ from typing import Callable, Optional, Tuple
 import numpy as np
 import torch
 import torch.nn as nn
-from torchmcubes import marching_cubes
+from skimage import measure
+
+
+def marching_cubes(vol: torch.Tensor, threshold: float):
+    """torchmcubes-compatible wrapper around skimage (CPU only).
+
+    torchmcubes returns vertices in (x, y, z) = (dim2, dim1, dim0) order; skimage
+    returns (dim0, dim1, dim2), so flip to match what the caller undoes.
+    """
+    v, f, _, _ = measure.marching_cubes(vol.detach().cpu().numpy(), level=threshold)
+    v = torch.from_numpy(np.ascontiguousarray(v[:, ::-1])).float()
+    f = torch.from_numpy(np.ascontiguousarray(f[:, ::-1])).long()
+    return v, f
 
 
 class IsosurfaceHelper(nn.Module):
